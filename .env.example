NODE_ENV=production
TZ=America/Sao_Paulo
PORT=3000

# URL interna do serviço lexia dentro da rede do projeto EasyPanel
LEXIA_URL=http://lexia:3000
# Mesmo valor configurado no serviço lexia (cabeçalho x-ncm-secret)
LEXIA_SECRET=

NEXT_PUBLIC_SITE_URL=https://ncm.adv.br
NEXT_PUBLIC_GADS_TAG=AW-18397512561
# Ação de conversão "NCM Formulario Enviado", da mesma conta da tag acima.
# Se um dia a ação vier de outra conta, lib/config.ts carrega as duas — mas
# duas contas carregadas significam coleta de remarketing nas duas.
NEXT_PUBLIC_GADS_CONVERSION=AW-18397512561/-YUXCL_TneccEPGGz8RE
NEXT_PUBLIC_WHATSAPP=5511910144241
